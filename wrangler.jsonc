{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "telegram-instant-link-bot",
  "main": "index.js",
  "compatibility_date": "2026-10-03",
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
